{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chunkydiscord",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth uses Node's async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // The live site. Cloudflare creates the DNS record and certificate for it on deploy.
  "routes": [{ "pattern": "chunkydrive.satwikdevs.in", "custom_domain": true }],
  // The built web app (web/dist) is served by this Worker too. /api/* goes to the code
  // in src/; every other path is the page, with unknown paths (like /signup) getting index.html.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chunky-drive",
      "database_id": "7e570963-5281-4274-be11-f851116b6776",
      "remote": true
    }
  ],
  "vars": {
    "CHANNEL_IDS": "1350373304804053094,1350366620798681199",
    // Where users open the site. Locally, .dev.vars overrides this with http://localhost:5173.
    "BETTER_AUTH_URL": "https://chunkydrive.satwikdevs.in",
    // Sender for sign-up codes and password resets (domain must be verified in Resend).
    "MAIL_FROM": "noreply@satwikdevs.in",
    "MAIL_FROM_NAME": "Chunky Drive"
  }
  // Secrets live in .dev.vars locally (see .dev.vars.example), and are set with
  // `npx wrangler secret put <NAME>` before deploying.
}
