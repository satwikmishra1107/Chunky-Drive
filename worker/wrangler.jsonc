{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chunkydrive",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "chunkydrive.satwikdevs.in", "custom_domain": true }],
  "workers_dev": false,
   "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chunky-drive",
      "database_id": "7e570963-5281-4274-be11-f851116b6776",
      "remote": true
    }
  ],
  "vars": {
    "CHANNEL_IDS": "1560709921220071577,1560710173662777435",
    "BETTER_AUTH_URL": "https://chunkydrive.satwikdevs.in",
    "MAIL_FROM": "noreply@satwikdevs.in",
    "MAIL_FROM_NAME": "Chunky Drive"
  }
}
